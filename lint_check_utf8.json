 updates if difference is negligible\r\n        if (Math.abs(newScale - currentScale) > 0.001) {\r\n            actions.setCurrentScale(newScale);\r\n        }\r\n\r\n        // Map Scale to Camera Z position\r\n        // Scale 3 (Molecular) -> Z = 15\r\n        // Scale 2 (Atomic) -> Z = 5\r\n        // Scale 0.5 (Subatomic) -> Z = 1\r\n\r\n        // Simple linear mapping for now, or piece-wise\r\n        let targetZ = 5;\r\n        if (newScale > 2) {\r\n            // Atomic(2) to Molecular(14) -> 15 to 140\r\n            targetZ = THREE.MathUtils.mapLinear(newScale, 2, 14, 15, 140);\r\n        } else {\r\n            // Atomic(2) to Subatomic(0.5) -> 15 to 2.5\r\n            // Increased min Z from 0.5 to 2.5 to prevent clipping into the Nucleus\r\n            targetZ = THREE.MathUtils.mapLinear(newScale, 0.5, 2, 2.5, 15);\r\n        }\r\n\r\n        camera.position.setZ(targetZ); // eslint-disable-line react-hooks/immutability\r\n        camera.lookAt(0, 0, 0);\r\n    });\r\n\r\n    return null;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\Gemini\\QuantumExplorer\\src\\components\\scene\\LaboratoryBox.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Gemini\\QuantumExplorer\\src\\components\\scene\\SceneManager.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Gemini\\QuantumExplorer\\src\\components\\subatomic\\GluonField.tsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-