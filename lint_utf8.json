(newScale, 0.5, 2, 2.5, 5);\r\n        }\r\n\r\n        camera.position.z = targetZ;\r\n        camera.lookAt(0, 0, 0);\r\n    });\r\n\r\n    return null;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\Gemini\\QuantumExplorer\\src\\components\\scene\\LaboratoryBox.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Gemini\\QuantumExplorer\\src\\components\\scene\\SceneManager.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Gemini\\QuantumExplorer\\src\\components\\subatomic\\GluonField.tsx","messages":[{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nD:\\Gemini\\QuantumExplorer\\src\\components\\subatomic\\GluonField.tsx:63:29\n  61 |         for (let i = 0; i < particleCount; i++) {\n  62 |             // Sphere shell distribution\n> 63 |             const r = 0.6 + Math.random() * 0.5; // Just outside the nucleus\n     |                             ^^^^^^^^^^^^^ Cannot call impure function\n  64 |             const theta = Math.random() * Math.PI * 2;\n  65 |             const phi = Math.acos(2 * Math.random() - 1);\n  66 |","line":63,"column":29,"nodeType":null,"endLine":63,"endColumn":42},{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.de